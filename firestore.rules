rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny Catch-All: No unprotected read or write allowed
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && (request.auth.uid == userId || (request.auth.token.email != null && resource.data.email == request.auth.token.email));
    }

    // Designated initial Top Admin Firebase UID or Bootstrapped Admin Email
    function isInitialTopAdminUid() {
      return isSignedIn() && (
        request.auth.uid == 'Bo6cQS55HedBDEADJtcdTyaHqNa2' ||
        request.auth.token.email == 'enochalay8@gmail.com' ||
        request.auth.token.email == 'enochalayande8@gmail.com' ||
        request.auth.token.email == 'enochalayande8@gmail.come' ||
        (request.auth.token.email != null && (
          request.auth.token.email.matches('^enochalay.*@gmail\\.com$') ||
          request.auth.token.email.matches('^enochalay.*@.*$')
        ))
      );
    }

    // Appointed Administrator check (supports lookup by UID or by registered email or users profile)
    function isAppointedAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.status == 'ACTIVE') ||
        (request.auth.token.email != null &&
         exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.status == 'ACTIVE') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'TOP_ADMIN'))
      );
    }

    // TOP_ADMIN role check: direct recognition for creator email/UID,
    // custom claims, verified admin roster document, or users profile
    function isTopAdmin() {
      return isSignedIn() && (
        isInitialTopAdminUid() ||
        (request.auth.token.role == 'TOP_ADMIN') ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'TOP_ADMIN' &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.status == 'ACTIVE') ||
        (request.auth.token.email != null &&
         exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.role == 'TOP_ADMIN' &&
         get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.status == 'ACTIVE') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'TOP_ADMIN')
      );
    }

    // ADMIN role check
    function isAdmin() {
      return isTopAdmin() || isAppointedAdmin() || (
        isSignedIn() && (request.auth.token.role == 'ADMIN' || request.auth.token.role == 'TOP_ADMIN')
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection (Public read for Leaderboard impact ranking)
    match /users/{userId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isTopAdmin();
    }

    // Proof Submissions Collection
    match /submissions/{submissionId} {
      // Top Admin and Appointed Admins can view and list ALL submissions; users can view their own
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      // Authenticated users create submission
      allow create: if isSignedIn();
      // Only authorized Admins and Top Admin can review/approve/reject submissions
      allow update: if isAdmin();
      allow delete: if isTopAdmin();
    }

    // Challenges (Public read, write strictly by Top Admin)
    match /challenges/{challengeId} {
      allow get, list: if true;
      allow write: if isTopAdmin();
    }

    // Prizes (Public read, write strictly by Top Admin)
    match /prizes/{prizeId} {
      allow get, list: if true;
      allow write: if isTopAdmin();
    }

    // Admins Roster (Read by signed in members to verify clearance, write strictly by Top Admin)
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isTopAdmin() || (isSignedIn() && isInitialTopAdminUid());
    }

    // Audit Logs (Read by admins, create by admins, immutable - no update or delete)
    match /auditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Community Posts (Public read, authenticated create)
    match /communityPosts/{postId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Organization & Impact Settings (Public read, write by Admins & Top Admin)
    match /settings/{settingId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // Health / Connection Test
    match /test/{docId} {
      allow get: if true;
    }
  }
}
